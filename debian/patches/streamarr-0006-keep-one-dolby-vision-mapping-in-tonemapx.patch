Forwarded: no
Last-Update: 2026-11-11
---
Index: FFmpeg/libavfilter/vf_tonemapx.c
===================================================================
--- FFmpeg.orig/libavfilter/vf_tonemapx.c
+++ FFmpeg/libavfilter/vf_tonemapx.c
@@ -1574,16 +1574,16 @@ static int filter_frame(AVFilterLink *link, AVFrame *in)
         // such videos usually have vdr_rpu_profile == 0, for example profile 5 videos
         // this could be wrong as there is no public documentation on this field
         if (rpu->disable_residual_flag && rpu->vdr_rpu_profile == 0) {
-            struct FFDOVIMetadataRemap *dovi;
-
             // Before s->dovi is set: a later frame takes the Dolby Vision path whenever it is.
             if ((ret = compute_dovi_pq_luts(s)) < 0)
                 goto fail;
 
-            dovi = av_malloc(sizeof(*dovi));
-            s->dovi = dovi;
-            if (!s->dovi)
+            // One buffer serves every frame: the mapping below rewrites each field that the
+            // reshaping of this frame reads.
+            if (!s->dovi && !(s->dovi = av_malloc(sizeof(*s->dovi)))) {
+                ret = AVERROR(ENOMEM);
                 goto fail;
+            }
 
             ff_map_dovi_metadata(s->dovi, metadata);
             in->color_trc = AVCOL_TRC_SMPTE2084;

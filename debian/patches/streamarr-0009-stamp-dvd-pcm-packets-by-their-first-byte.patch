Index: FFmpeg/libavformat/mpeg.c
===================================================================
--- FFmpeg.orig/libavformat/mpeg.c
+++ FFmpeg/libavformat/mpeg.c
@@ -22,6 +22,7 @@
 #include "config_components.h"
 
 #include "libavutil/channel_layout.h"
+#include "libavutil/mathematics.h"
 #include "libavutil/mem.h"
 #include "avformat.h"
 #include "avio_internal.h"
@@ -487,7 +488,7 @@ static int mpegps_read_packet(AVFormatContext *s,
     AVStream *st;
     FFStream *sti;
     int len, startcode, i, es_type, ret;
-    int pcm_dvd = 0;
+    int pcm_dvd = 0, lpcm_pointer = 0, lpcm_header = 0;
     int request_probe= 0;
     enum AVCodecID codec_id = AV_CODEC_ID_NONE;
     enum AVMediaType type;
@@ -504,7 +505,14 @@ redo:
 
         if (!m->raw_ac3) {
             /* audio: skip header */
-            avio_skip(s->pb, 3);
+            if (startcode >= 0xa0 && startcode <= 0xaf) {
+                /* LPCM: skip the number of frames that start in the payload, and read where
+                 * the first one starts, counted from the next byte (4 is the payload's first
+                 * byte after the 3 header bytes) */
+                avio_skip(s->pb, 1);
+                lpcm_pointer = avio_rb16(s->pb);
+            } else
+                avio_skip(s->pb, 3);
             len -= 3;
             if (startcode >= 0xb0 && startcode <= 0xbf) {
                 /* MLP/TrueHD audio has a 4-byte header */
@@ -514,7 +522,8 @@ redo:
                 ret = ffio_ensure_seekback(s->pb, 3);
                 if (ret < 0)
                     return ret;
-                pcm_dvd = (avio_rb24(s->pb) & 0xFF) == 0x80;
+                lpcm_header = avio_rb24(s->pb);
+                pcm_dvd     = (lpcm_header & 0xFF) == 0x80;
                 avio_skip(s->pb, -3);
             }
         }
@@ -656,6 +665,22 @@ found:
             len -=6;
       }
     }
+    if (st->codecpar->codec_id == AV_CODEC_ID_PCM_DVD && pcm_dvd &&
+        lpcm_pointer > 4 && lpcm_pointer - 4 < len - 3) {
+        /* The timestamp names the first frame that starts in the payload, lpcm_pointer - 4
+         * bytes after the payload's first byte. Move it back to that byte, the packet's first
+         * sample after the 3 header bytes. */
+        static const int rates[4] = { 48000, 96000, 44100, 32000 };
+        int bits     = 16 + (lpcm_header >> 14 & 3) * 4;
+        int channels = 1 + (lpcm_header >> 8 & 7);
+        int64_t lead = av_rescale(lpcm_pointer - 4, 8 * 90000LL,
+                                  (int64_t)rates[lpcm_header >> 12 & 3] * channels * bits);
+
+        if (pts != AV_NOPTS_VALUE)
+            pts = (pts - lead) & ((1LL << 33) - 1);
+        if (dts != AV_NOPTS_VALUE)
+            dts = (dts - lead) & ((1LL << 33) - 1);
+    }
     ret = av_get_packet(s->pb, pkt, len);
 
     pkt->pts          = pts;
Index: FFmpeg/libavformat/mpegenc.c
===================================================================
--- FFmpeg.orig/libavformat/mpegenc.c
+++ FFmpeg/libavformat/mpegenc.c
@@ -913,6 +913,16 @@ static int flush_packet(AVFormatContext *ctx, int stre
         if (startcode == PRIVATE_STREAM_1 && id >= 0xa0) {
             if (payload_size < av_fifo_can_read(stream->fifo))
                 stuffing_size += payload_size % stream->lpcm_align;
+            /* The timestamp names the first frame that starts in the payload. When the rest of
+             * the frame before fills the aligned payload, no frame starts in it. */
+            if (pts != AV_NOPTS_VALUE && payload_size - stuffing_size <= trailer_size) {
+                int timestamp_len = (dts != pts ? 5 : 0) + (s->is_mpeg2 ? 5 : 4);
+                pts            =
+                dts            = AV_NOPTS_VALUE;
+                header_len    -= timestamp_len;
+                payload_size  += timestamp_len;
+                stuffing_size += timestamp_len;
+            }
         }
 
         if (stuffing_size > 16) {   /* <=16 for MPEG-1, <=32 for MPEG-2 */
@@ -990,9 +1000,11 @@ static int flush_packet(AVFormatContext *ctx, int stre
         if (startcode == PRIVATE_STREAM_1) {
             avio_w8(ctx->pb, id);
             if (id >= 0xa0) {
-                /* LPCM (XXX: check nb_frames) */
-                avio_w8(ctx->pb, 7);
-                avio_wb16(ctx->pb, 4); /* skip 3 header bytes */
+                /* LPCM: the number of frames that start in the payload, and the first one's
+                 * offset from the next byte, past the 3 header bytes (4 is the payload's
+                 * first byte); 0 when none starts */
+                avio_w8(ctx->pb, FFMIN(nb_frames, 255));
+                avio_wb16(ctx->pb, nb_frames ? trailer_size + 4 : 0);
                 avio_w8(ctx->pb, stream->lpcm_header[0]);
                 avio_w8(ctx->pb, stream->lpcm_header[1]);
                 avio_w8(ctx->pb, stream->lpcm_header[2]);

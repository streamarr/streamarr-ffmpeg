+static int is_gap_fill(const AVFilterContext *f)
+{
+    return !strcmp(f->filter->name, "agapfill");
+}
+
+/* An agapfill filter that has taken no frame reports nothing, and the filter
+ * in its place then starts afresh. */
+static int note_gap_fill_positions(AVFilterGraph *graph, AVDictionary **positions)
+{
+    for (unsigned i = 0; i < graph->nb_filters; i++) {
+        AVFilterContext *f = graph->filters[i];
+        char position[64] = "";
+        int ret;
+
+        if (!is_gap_fill(f))
+            continue;
+
+        ret = avfilter_process_command(f, "position", NULL, position, sizeof(position), 0);
+        if (ret >= 0 && position[0])
+            ret = av_dict_set(positions, f->name, position, 0);
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}
+
+/* The same graph description gives each filter the same name again. */
+static int resume_gap_fills(AVFilterGraph *graph, const AVDictionary *positions)
+{
+    for (unsigned i = 0; i < graph->nb_filters; i++) {
+        AVFilterContext *f = graph->filters[i];
+        const AVDictionaryEntry *position;
+        int ret;
+
+        if (!is_gap_fill(f))
+            continue;
+
+        position = av_dict_get(positions, f->name, NULL, AV_DICT_MATCH_CASE);
+        if (!position)
+            continue;
+
+        ret = avfilter_process_command(f, "resume", position->value, NULL, 0, 0);
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}
+

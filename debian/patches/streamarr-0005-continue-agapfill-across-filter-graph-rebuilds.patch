+/**
+ * Continue the output of another agapfill filter, from what its position
+ * command reported. The first frame is then one more step for place_frame.
+ */
+static int resume(AVFilterContext *ctx, const char *position)
+{
+    AVFilterLink *inlink = ctx->inputs[0];
+    AGapFillContext *s = ctx->priv;
+    const AVRational sample = { 1, inlink->sample_rate };
+    int64_t out_pos, in_end;
+    int sample_rate;
+
+    if (!position || inlink->sample_rate <= 0 ||
+        sscanf(position, "%"SCNd64"/%"SCNd64"/%d", &out_pos, &in_end, &sample_rate) != 3 ||
+        sample_rate <= 0) {
+        av_log(ctx, AV_LOG_ERROR,
+               "resume takes what the position command of a configured filter reports.\n");
+        return AVERROR(EINVAL);
+    }
+    if (s->started)
+        return 0;
+
+    s->out_pos = av_rescale_q_rnd(out_pos, (AVRational){ 1, sample_rate }, sample,
+                                  AV_ROUND_NEAR_INF);
+    s->in_end  = av_rescale_q_rnd(in_end, (AVRational){ 1, sample_rate }, sample,
+                                  AV_ROUND_NEAR_INF);
+    s->started = 1;
+
+    return 0;
+}
+
+static int process_command(AVFilterContext *ctx, const char *cmd, const char *args,
+                           char *res, int res_len, int flags)
+{
+    AGapFillContext *s = ctx->priv;
+
+    if (!strcmp(cmd, "resume"))
+        return resume(ctx, args);
+    if (strcmp(cmd, "position") && strcmp(cmd, "pending"))
+        return AVERROR(ENOSYS);
+    if (!res || res_len <= 0)
+        return AVERROR(EINVAL);
+
+    if (!strcmp(cmd, "pending")) {
+        snprintf(res, res_len, "%zu", !!s->held + ff_inlink_queued_frames(ctx->inputs[0]));
+        return 0;
+    }
+
+    /* Nothing to continue before the first frame. */
+    res[0] = 0;
+    if (s->started)
+        snprintf(res, res_len, "%"PRId64"/%"PRId64"/%d",
+                 s->out_pos, s->in_end, ctx->inputs[0]->sample_rate);
+
+    return 0;
+}
+
 static av_cold void uninit(AVFilterContext *ctx)
 {
     AGapFillContext *s = ctx->priv;

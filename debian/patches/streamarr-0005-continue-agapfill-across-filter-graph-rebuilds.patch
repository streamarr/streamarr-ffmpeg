+/* Marks in reached, by their index in graph, the filters that frames leaving
+ * graph->filters[from] pass. A graph may hold a cycle, for example through the
+ * feedback filter, so the walk enters each filter once. */
+static void mark_reached(const AVFilterGraph *graph, unsigned from, uint8_t *reached)
+{
+    const AVFilterContext *f = graph->filters[from];
+
+    reached[from] = 1;
+    for (unsigned i = 0; i < f->nb_outputs; i++)
+        for (unsigned j = 0; f->outputs[i] && j < graph->nb_filters; j++)
+            if (!reached[j] && graph->filters[j] == f->outputs[i]->dst)
+                mark_reached(graph, j, reached);
+}
+
+/* Marks in fed the outputs of fg that frames leaving graph->filters[from] reach. */
+static int find_outputs_behind(FilterGraph *fg, const AVFilterGraph *graph,
+                               unsigned from, uint8_t *fed)
+{
+    uint8_t *reached = av_calloc(graph->nb_filters, sizeof(*reached));
+
+    if (!reached)
+        return AVERROR(ENOMEM);
+
+    mark_reached(graph, from, reached);
+    for (int i = 0; i < fg->nb_outputs; i++) {
+        fed[i] = 0;
+        for (unsigned j = 0; j < graph->nb_filters; j++)
+            if (graph->filters[j] == fg->outputs[i]->filter)
+                fed[i] = reached[j];
+    }
+
+    av_free(reached);
+    return 0;
+}
+
+static int gap_fill_is_pending(AVFilterContext *f)
+{
+    char pending[32] = "0";
+
+    return avfilter_process_command(f, "pending", NULL, pending, sizeof(pending), 0) >= 0 &&
+           strcmp(pending, "0");
+}
+
+/* Ask each output marked in fed for a frame until one gives none, then send
+ * on what the outputs hold. Returns whether every output gave a frame and one
+ * of them takes frames, so 0 when none takes frames. An output whose consumer
+ * has finished, for example after -frames, discards every frame, so its
+ * frames are no reason to ask on. It is still asked, because a filter on its
+ * way may wait for another input and keep every frame it is handed. */
+static int pull_frames_behind(FilterGraph *fg, FilterGraphThread *fgt,
+                              const uint8_t *fed, AVFrame *frame)
+{
+    int taken = 0, waits = 0;
+
+    for (int i = 0; i < fg->nb_outputs && !waits; i++) {
+        AVFilterContext *sink = fg->outputs[i]->filter;
+        int ret;
+
+        if (!fed[i])
+            continue;
+
+        ret = av_buffersink_get_frame_flags(sink, NULL, AV_BUFFERSINK_FLAG_PEEK);
+        if (ret == AVERROR_EOF)
+            continue;
+        if (ret < 0 && ret != AVERROR(EAGAIN))
+            return ret;
+
+        taken |= !fgt->eof_out[i];
+        waits  = ret == AVERROR(EAGAIN);
+    }
+
+    for (int i = 0; i < fg->nb_outputs; i++) {
+        int ret = 0;
+
+        while (!ret) {
+            ret = fg_output_step(ofp_from_ofilter(fg->outputs[i]), fgt, frame);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    return taken && !waits;
+}
+
+/* Ask the outputs behind graph->filters[index], an agapfill filter, for
+ * frames until it has output all it has. Returns 1 when the asking stops
+ * first: a filter behind it waits for another input of the graph, or no
+ * output behind it takes frames. */
+static int finish_gap_fill(FilterGraph *fg, FilterGraphThread *fgt, unsigned index,
+                           uint8_t *fed, AVFrame *frame)
+{
+    AVFilterContext *f = fgt->graph->filters[index];
+    int ret = find_outputs_behind(fg, fgt->graph, index, fed);
+
+    while (ret >= 0 && gap_fill_is_pending(f)) {
+        ret = pull_frames_behind(fg, fgt, fed, frame);
+        if (!ret)
+            return 1;
+    }
+
+    return FFMIN(ret, 0);
+}
+
+/**
+ * An agapfill filter writes a gap one frame of silence for each frame its
+ * output asks for, and holds the frame after the gap and the frames behind it
+ * until then. Freeing the graph would take those frames with it. So ask the
+ * outputs for frames until every agapfill filter has output all it has.
+ *
+ * An output gives no frame when a filter behind agapfill waits for another
+ * input of the graph, for example amix. That input cannot arrive before the
+ * graph is rebuilt, so asking the other outputs on would only pile the rest
+ * of the gap up in the waiting filter. The asking stops there, and the filter
+ * of the new graph writes the time of the frames agapfill still holds as
+ * silence: its position leaves them out.
+ *
+ * Asking one agapfill filter for frames can hand frames to another agapfill
+ * filter behind it, which the graph may list first. So the walk over the
+ * filters starts again until it finds none to ask. A filter whose asking
+ * stopped is not asked again.
+ */
+static int finish_gap_fills(FilterGraph *fg, FilterGraphThread *fgt, AVFrame *frame)
+{
+    AVFilterGraph *graph = fgt->graph;
+    uint8_t *fed     = av_calloc(fg->nb_outputs, sizeof(*fed));
+    uint8_t *stopped = av_calloc(graph->nb_filters, sizeof(*stopped));
+    int ret = fed && stopped ? 0 : AVERROR(ENOMEM);
+    int asked = 1;
+
+    while (ret >= 0 && asked) {
+        asked = 0;
+        for (unsigned i = 0; ret >= 0 && i < graph->nb_filters; i++) {
+            AVFilterContext *f = graph->filters[i];
+
+            if (stopped[i] || !is_gap_fill(f) || !gap_fill_is_pending(f))
+                continue;
+
+            ret = finish_gap_fill(fg, fgt, i, fed, frame);
+            stopped[i] = ret > 0;
+            asked = 1;
+        }
+    }
+
+    av_free(fed);
+    av_free(stopped);
+    return FFMIN(ret, 0);
+}
+

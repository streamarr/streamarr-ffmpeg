+static int is_gap_fill(const AVFilterContext *f)
+{
+    return !strcmp(f->filter->name, "agapfill");
+}
+
+/* An agapfill filter that has taken no frame reports nothing, and the filter
+ * in its place then starts afresh. */
+static int note_gap_fill_positions(AVFilterGraph *graph, AVDictionary **positions)
+{
+    unsigned place = 0;
+
+    for (unsigned i = 0; i < graph->nb_filters; i++) {
+        AVFilterContext *f = graph->filters[i];
+        /* The longest report: three timestamps of 20 characters, each with a
+         * slash after it, and a sample rate of 10 digits. */
+        char position[3 * 21 + 10 + 1] = "";
+        char key[11];
+        int ret;
+
+        if (!is_gap_fill(f))
+            continue;
+
+        snprintf(key, sizeof(key), "%u", place++);
+        ret = avfilter_process_command(f, "position", NULL, position, sizeof(position), 0);
+        if (ret >= 0 && position[0])
+            ret = av_dict_set(positions, key, position, 0);
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}
+
+/* A name does not tell two filters apart: ffmpeg accepts an instance name
+ * twice, and cuts a name to 63 characters. The same graph description gives
+ * the agapfill filters the same order again. */
+static int resume_gap_fills(AVFilterGraph *graph, const AVDictionary *positions)
+{
+    unsigned place = 0;
+
+    for (unsigned i = 0; i < graph->nb_filters; i++) {
+        AVFilterContext *f = graph->filters[i];
+        const AVDictionaryEntry *position;
+        char key[11];
+        int ret;
+
+        if (!is_gap_fill(f))
+            continue;
+
+        snprintf(key, sizeof(key), "%u", place++);
+        position = av_dict_get(positions, key, NULL, 0);
+        if (!position)
+            continue;
+
+        ret = avfilter_process_command(f, "resume", position->value, NULL, 0, 0);
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}
+

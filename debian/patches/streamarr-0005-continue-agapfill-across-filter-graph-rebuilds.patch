Index: FFmpeg/libavfilter/af_agapfill.c
===================================================================
--- FFmpeg.orig/libavfilter/af_agapfill.c
+++ FFmpeg/libavfilter/af_agapfill.c
@@ -21,6 +21,10 @@
  * Fill gaps between audio frames with silence, without dropping a sample.
  */
 
+#include <inttypes.h>
+#include <stdio.h>
+#include <string.h>
+
 #include "libavutil/common.h"
 #include "libavutil/mathematics.h"
 #include "libavutil/opt.h"
@@ -38,7 +42,7 @@ typedef struct AGapFillContext {
     int64_t max_gap;        ///< longest silence to write, in microseconds; 0 for no limit
     int packet_size;        ///< samples in each frame of silence
 
-    int started;            ///< the first frame has arrived
+    int started;            ///< the first frame has arrived, or the filter continues another one
     int64_t out_pos;        ///< timestamp of the next output sample, in samples
     int64_t in_end;         ///< end of the previous input frame by its own timestamp, in samples
     int64_t silence_left;   ///< samples of silence still to write before the held frame
@@ -244,6 +248,58 @@ static int config_output(AVFilterLink *o
     return 0;
 }
 
+/**
+ * Continue the output of another agapfill filter, from what its position
+ * command reported. The first frame is then one more step for place_frame.
+ */
+static int resume(AVFilterContext *ctx, const char *position)
+{
+    AVFilterLink *inlink = ctx->inputs[0];
+    AGapFillContext *s = ctx->priv;
+    const AVRational sample = { 1, inlink->sample_rate };
+    int64_t out_pos, in_end;
+    int sample_rate;
+
+    if (!position || inlink->sample_rate <= 0 ||
+        sscanf(position, "%"SCNd64"/%"SCNd64"/%d", &out_pos, &in_end, &sample_rate) != 3 ||
+        sample_rate <= 0) {
+        av_log(ctx, AV_LOG_ERROR,
+               "resume takes what the position command of a configured filter reports.\n");
+        return AVERROR(EINVAL);
+    }
+    if (s->started)
+        return 0;
+
+    s->out_pos = av_rescale_q_rnd(out_pos, (AVRational){ 1, sample_rate }, sample,
+                                  AV_ROUND_NEAR_INF);
+    s->in_end  = av_rescale_q_rnd(in_end, (AVRational){ 1, sample_rate }, sample,
+                                  AV_ROUND_NEAR_INF);
+    s->started = 1;
+
+    return 0;
+}
+
+static int process_command(AVFilterContext *ctx, const char *cmd, const char *args,
+                           char *res, int res_len, int flags)
+{
+    AGapFillContext *s = ctx->priv;
+
+    if (!strcmp(cmd, "resume"))
+        return resume(ctx, args);
+    if (strcmp(cmd, "position"))
+        return AVERROR(ENOSYS);
+    if (!res || res_len <= 0)
+        return AVERROR(EINVAL);
+
+    /* Nothing to continue before the first frame. */
+    res[0] = 0;
+    if (s->started)
+        snprintf(res, res_len, "%"PRId64"/%"PRId64"/%d",
+                 s->out_pos, s->in_end, ctx->inputs[0]->sample_rate);
+
+    return 0;
+}
+
 static av_cold void uninit(AVFilterContext *ctx)
 {
     AGapFillContext *s = ctx->priv;
@@ -265,12 +321,13 @@ static const AVFilterPad agapfill_output
 };
 

+/* Whether frames that leave f reach sink. */
+static int filter_feeds(const AVFilterContext *f, const AVFilterContext *sink)
+{
+    if (f == sink)
+        return 1;
+
+    for (unsigned i = 0; i < f->nb_outputs; i++)
+        if (f->outputs[i] && filter_feeds(f->outputs[i]->dst, sink))
+            return 1;
+
+    return 0;
+}
+
+static int gap_fill_is_pending(AVFilterContext *f)
+{
+    char pending[32] = "0";
+
+    return avfilter_process_command(f, "pending", NULL, pending, sizeof(pending), 0) >= 0 &&
+           strcmp(pending, "0");
+}
+
+/* Ask each output that f feeds for a frame, then send on what the outputs
+ * hold. Returns whether a frame came. An output whose consumer has finished,
+ * for example after -frames, would discard every frame, so it is not asked. */
+static int pull_frames_behind(FilterGraph *fg, FilterGraphThread *fgt,
+                              const AVFilterContext *f, AVFrame *frame)
+{
+    int pulled = 0;
+
+    for (int i = 0; i < fg->nb_outputs; i++) {
+        AVFilterContext *sink = fg->outputs[i]->filter;
+        int ret;
+
+        if (fgt->eof_out[i] || !filter_feeds(f, sink))
+            continue;
+
+        ret = av_buffersink_get_frame_flags(sink, NULL, AV_BUFFERSINK_FLAG_PEEK);
+        if (ret == AVERROR(EAGAIN) || ret == AVERROR_EOF)
+            continue;
+        if (ret < 0)
+            return ret;
+
+        pulled = 1;
+    }
+
+    for (int i = 0; i < fg->nb_outputs; i++) {
+        int ret = 0;
+
+        while (!ret) {
+            ret = fg_output_step(ofp_from_ofilter(fg->outputs[i]), fgt, frame);
+            if (ret < 0)
+                return ret;
+        }
+    }
+
+    return pulled;
+}
+
+/**
+ * An agapfill filter writes a gap one frame of silence for each frame its
+ * output asks for, and holds the frame after the gap and the frames behind it
+ * until then. Freeing the graph would take those frames with it. So ask the
+ * outputs for frames until every agapfill filter has output all it has.
+ */
+static int finish_gap_fills(FilterGraph *fg, FilterGraphThread *fgt, AVFrame *frame)
+{
+    for (unsigned i = 0; i < fgt->graph->nb_filters; i++) {
+        AVFilterContext *f = fgt->graph->filters[i];
+        int ret = 1;
+
+        if (!is_gap_fill(f))
+            continue;
+
+        /* No frame comes when a filter behind f has ended its output or
+         * waits for another input, or when no output behind f takes frames. */
+        while (ret > 0 && gap_fill_is_pending(f))
+            ret = pull_frames_behind(fg, fgt, f, frame);
+        if (ret < 0)
+            return ret;
+    }
+
+    return 0;
+}

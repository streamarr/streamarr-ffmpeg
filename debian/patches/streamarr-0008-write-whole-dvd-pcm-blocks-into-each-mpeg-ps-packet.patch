Description: avformat/mpegenc: write whole DVD PCM blocks into each MPEG-PS packet
 The muxer cut each DVD PCM payload at a multiple of one sample frame,
 channels * bits / 8 bytes. The DVD PCM decoder reads 20 and 24 bit
 samples in blocks: the upper 16 bits of four samples, then their lower
 bits. A block is 12 bytes for one, two or four channels at 24 bits and
 72 bytes for 5.1, so most 24-bit payloads started inside a block.
 .
 A decode that starts after a seek takes the first byte of its first
 packet as the start of a block. From such a payload it mixes the bytes
 of different samples, and the carry from packet to packet keeps that
 phase: near full-scale noise to the end of the decode.
 .
 Cut payloads at multiples of the decoder's block instead. A 16-bit block
 is one sample frame, so 16-bit output does not change. 24-bit files grow
 by the padding of the shorter payloads, 0.3 % for stereo and 2.7 % for
 5.1 in FATE.
 .
 A packet with no room for a block after its headers holds no samples. If
 every packet of a stream is that small, the stream never drains and the
 muxer writes empty packets forever, so refuse such packet sizes. 24-bit
 5.1 then needs packets of at least 113 bytes in an MPEG-2 program stream;
 the default is 2048.
 .
 The SCR advances by one whole packet at the mux rate, so each packet
 must carry the samples of that time. The automatic mux rate adds 5 % to
 the streams' bit rates for headers. Whole blocks can leave most of a
 block of a packet unused, and below about 1000 bytes the headers alone
 take more than 5 % of a packet. 24-bit 5.1 in 2050-byte packets carried
 1944 bytes where whole sample frames carried 1998, and the SCR ran ahead
 of the samples by 2.4 ms a second; 7 channels did the same in 2048-byte
 packets. In 600-byte packets, even without whole blocks, 24-bit 5.1
 carried 31 samples, 58.1 ticks of 90 kHz, while the SCR advanced 59. So
 for the mux rate, each DVD PCM stream needs its bit rate times the
 packet size over its smallest payload: the whole blocks that fit after a
 pack header, a PTS and a DTS. That share holds the headers, and the 5 %
 go spare. Where a block is one sample frame, as at 16 bits, the payloads
 and the rate do not change.
Author: Streamarr
Forwarded: no
Last-Update: 2026-11-12
---
Index: FFmpeg/libavformat/mpegenc.c
===================================================================
--- FFmpeg.orig/libavformat/mpegenc.c
+++ FFmpeg/libavformat/mpegenc.c
@@ -300,6 +300,58 @@ static int get_system_header_size(AVFormatContext *ctx)
     return buf_index;
 }
 
+/* The bytes of one block of the DVD PCM decoder (libavcodec/pcm-dvd.c). 20 and 24 bit samples
+ * come in groups of four: the upper 16 bits of each, then their lower bits. A decode that
+ * starts after a seek takes the first byte of its first packet as the start of a block. */
+static int pcm_dvd_block_size(const AVCodecParameters *par)
+{
+    int channels = par->ch_layout.nb_channels;
+    int bits     = par->bits_per_coded_sample;
+
+    if (bits == 16)
+        return 2 * channels;
+    switch (channels) {
+    case 1:
+    case 2:
+    case 4:
+        return 4 * bits / 8;
+    case 8:
+        return 8 * bits / 8;
+    default:
+        return 4 * channels * bits / 8;
+    }
+}
+
+/* The bytes that flush_packet() writes before the samples of an LPCM packet with a pack header,
+ * a PTS and a DTS: the pack header, the PES header, the substream ID and the LPCM header. Only
+ * the first packet of a stream and a packet with a system header have more. */
+static int lpcm_packet_overhead(const MpegMuxContext *s)
+{
+    int pack_header = s->is_mpeg2 ? 14 : 12;
+    int pes_header  = 6 + (s->is_mpeg2 ? 3 + 1 : 0) + 5 + 5;
+
+    return pack_header + pes_header + 1 + 6;
+}
+
+/* The bit rate that a DVD PCM stream of the given rate needs in the mux rate. The SCR advances by
+ * one whole packet at the mux rate, so each packet must carry the samples of that time. Whole
+ * blocks can leave most of a block of a packet unused, and the headers of a small packet take
+ * more than the 5 % that mpeg_mux_init() adds for them. So the stream needs its rate times the
+ * packet size over its smallest payload: the whole blocks that fit after the headers of
+ * lpcm_packet_overhead(). That share holds the headers, and the 5 % go spare. Where a block is
+ * one sample frame, as for 16 bits, four channels or eight, the payloads and the rate do not
+ * change. */
+static int lpcm_whole_block_rate(const MpegMuxContext *s, const AVCodecParameters *par, int rate)
+{
+    int block = pcm_dvd_block_size(par);
+    int frame = par->ch_layout.nb_channels * par->bits_per_coded_sample / 8;
+    int room  = s->packet_size - lpcm_packet_overhead(s);
+
+    if (block == frame)
+        return rate;
+    return av_rescale(rate, s->packet_size, room - room % block);
+}
+
 static av_cold int mpeg_mux_init(AVFormatContext *ctx)
 {
     MpegMuxContext *s = ctx->priv_data;
@@ -410,7 +462,16 @@ static av_cold int mpeg_mux_init(AVFormatContext *ctx)
                                          st->codecpar->ch_layout.nb_channels - 1;
                 stream->lpcm_header[2] = 0x80;
                 stream->id = lpcm_id++;
-                stream->lpcm_align = st->codecpar->ch_layout.nb_channels * st->codecpar->bits_per_coded_sample / 8;
+                stream->lpcm_align = pcm_dvd_block_size(st->codecpar);
+                /* flush_packet() writes only whole blocks. Where the headers of
+                 * lpcm_packet_overhead() leave no room for one, the stream can stall, and the
+                 * muxer then writes empty packets forever. */
+                if (s->packet_size - lpcm_packet_overhead(s) < stream->lpcm_align) {
+                    av_log(ctx, AV_LOG_ERROR,
+                           "Packet size %d leaves no room for a %d-byte block of DVD PCM.\n",
+                           s->packet_size, stream->lpcm_align);
+                    return AVERROR(EINVAL);
+                }
             } else if (st->codecpar->codec_id == AV_CODEC_ID_MLP ||
                        st->codecpar->codec_id == AV_CODEC_ID_TRUEHD) {
                        av_log(ctx, AV_LOG_ERROR, "Support for muxing audio codec %s not implemented.\n",
@@ -503,6 +564,9 @@ static av_cold int mpeg_mux_init(AVFormatContext *ctx)
         else
             codec_rate = st->codecpar->bit_rate;
 
+        if (st->codecpar->codec_id == AV_CODEC_ID_PCM_DVD)
+            codec_rate = lpcm_whole_block_rate(s, st->codecpar, codec_rate);
+
         if (!codec_rate)
             codec_rate = (1 << 21) * 8 * 50 / ctx->nb_streams;
 

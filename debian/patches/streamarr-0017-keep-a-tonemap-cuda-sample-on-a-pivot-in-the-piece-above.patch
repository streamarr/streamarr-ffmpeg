Index: FFmpeg/libavfilter/vf_tonemap_cuda.c
===================================================================
--- FFmpeg.orig/libavfilter/vf_tonemap_cuda.c
+++ FFmpeg/libavfilter/vf_tonemap_cuda.c
@@ -505,10 +505,14 @@ static void update_dovi_buf(AVFilterContext *ctx)
 
         // dovi_pivots
         if (comp->num_pivots > 2) {
-            // Skip the (irrelevant) lower and upper bounds
+            // The kernel reads a code to within a few float ulps of code / (2^depth - 1), sometimes
+            // just below the pivot of the same code. Lowering each pivot by 2^-21, 8 ulps at 0.5,
+            // keeps such a sample in the piece that starts at the pivot. The GPU tested filters
+            // chroma to whole 16-bit steps, 32 times 2^-21, so no filtered read changes piece.
             float pivots_data[7+1] = {0};
-            memcpy(pivots_data, comp->pivots + 1,
-                   (comp->num_pivots - 2) * sizeof(pivots_data[0]));
+            // Skip the (irrelevant) lower and upper bounds
+            for (i = 0; i < comp->num_pivots - 2; i++)
+                pivots_data[i] = comp->pivots[i + 1] - 0x1p-21f;
             // Fill the remainder with a quasi-infinite sentinel pivot
             for (i = comp->num_pivots - 2; i < FF_ARRAY_ELEMS(pivots_data); i++)
                 pivots_data[i] = 1e9f;

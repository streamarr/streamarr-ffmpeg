+/**
+ * @file
+ * Fill gaps between audio frames with silence, without dropping a sample.
+ */
+
+#include "libavutil/common.h"
+#include "libavutil/mathematics.h"
+#include "libavutil/opt.h"
+#include "libavutil/samplefmt.h"
+
+#include "audio.h"
+#include "avfilter.h"
+#include "filters.h"
+
+typedef struct AGapFillContext {
+    const AVClass *class;
+
+    int64_t threshold;      ///< longest step between frames that passes through, in microseconds
+    int64_t start;          ///< time from which silence leads the first frame, in microseconds; INT64_MAX when unset
+    int64_t max_gap;        ///< longest silence to write, in microseconds; 0 for no limit
+    int packet_size;        ///< samples in each frame of silence
+
+    int started;            ///< the first frame has arrived
+    int64_t out_pos;        ///< timestamp of the next output sample, in samples
+    int64_t in_end;         ///< end of the previous input frame by its own timestamp, in samples
+    int64_t silence_left;   ///< samples of silence still to write before the held frame
+    AVFrame *held;          ///< input frame that waits for the silence before it
+
+    int64_t nb_gaps;        ///< runs of silence written, the leading one included
+    int64_t nb_silence;     ///< samples of silence in those runs
+    int64_t nb_joined;      ///< backward steps above the threshold, joined without silence
+    int64_t nb_passed;      ///< steps at or below the threshold, which the output took too
+    int64_t max_offset;     ///< largest distance of a frame from its own timestamp, in samples
+} AGapFillContext;
+
+#define OFFSET(x) offsetof(AGapFillContext, x)
+#define A AV_OPT_FLAG_AUDIO_PARAM | AV_OPT_FLAG_FILTERING_PARAM
+
+static const AVOption agapfill_options[] = {
+    { "threshold",   "set the longest step between frames that passes through", OFFSET(threshold),   AV_OPT_TYPE_DURATION, { .i64 = 2000 },      0,         INT64_MAX, A },
+    { "start",       "set the time from which silence leads the first frame",         OFFSET(start),       AV_OPT_TYPE_DURATION, { .i64 = INT64_MAX }, INT64_MIN, INT64_MAX, A },
+    { "max_gap",     "set the longest silence to write, 0 for no limit",              OFFSET(max_gap),     AV_OPT_TYPE_DURATION, { .i64 = 0 },         0,         INT64_MAX, A },
+    { "packet_size", "set the number of samples in each frame of silence",            OFFSET(packet_size), AV_OPT_TYPE_INT,      { .i64 = 4096 },      1,         65536,     A },
+    { NULL }
+};
+
+AVFILTER_DEFINE_CLASS(agapfill);
+
+/* Whether samples last longer than microseconds, which is not below zero.
+ * Whole seconds first, then the rest: av_compare_ts() is undefined where one
+ * value does not fit the other's time base, as 10^18 samples at 48 kHz do
+ * not. samples is unsigned, so that it holds the step between any two
+ * timestamps. */
+static int is_longer(const AVFilterLink *link, uint64_t samples, int64_t microseconds)
+{
+    const uint64_t rate    = link->sample_rate;
+    const uint64_t seconds = samples / rate, limit = microseconds / AV_TIME_BASE;
+
+    if (seconds != limit)
+        return seconds > limit;
+    return (samples % rate) * AV_TIME_BASE > (microseconds % AV_TIME_BASE) * rate;
+}
+
+/* A timestamp in the time base from, counted in the time base to. Where no
+ * timestamp in to reaches it, it stops at the largest or the smallest
+ * timestamp, as the output position does. av_rescale_q_rnd() answers
+ * INT64_MIN there, the value that means no timestamp. */
+static int64_t rescale_saturated(int64_t ts, AVRational from, AVRational to,
+                                 enum AVRounding rounding)
+{
+    const int64_t rescaled = av_rescale_q_rnd(ts, from, to, rounding);
+
+    if (rescaled != INT64_MIN)
+        return rescaled;
+    return ts < 0 ? INT64_MIN + 1 : INT64_MAX;
+}
+
+/* How far the timestamp to lies from the timestamp from. The distance
+ * between the largest and the smallest timestamp takes 64 unsigned bits. */
+static uint64_t distance(int64_t from, int64_t to)
+{
+    return to >= from ? (uint64_t)to - (uint64_t)from : (uint64_t)from - (uint64_t)to;
+}
+
+/* pos moved forward or back by length. It stops at the largest or the
+ * smallest timestamp, as the output position does. */
+static int64_t moved(int64_t pos, uint64_t length, int forward)
+{
+    if (forward)
+        return length >= (uint64_t)INT64_MAX - (uint64_t)pos ?
+               INT64_MAX : (int64_t)((uint64_t)pos + length);
+    return length >= (uint64_t)pos - (uint64_t)(INT64_MIN + 1) ?
+           INT64_MIN + 1 : (int64_t)((uint64_t)pos - length);
+}
+
+/* The silence that the step from the end of the previous input frame to
+ * input that begins at pts puts before that input. The step alone decides.
+ * Steps at or below the threshold never add up to a gap. */
+static uint64_t silence_after_step(AVFilterContext *ctx, int64_t pts)
+{
+    AGapFillContext *s = ctx->priv;
+
+    if (pts <= s->in_end ||
+        !is_longer(ctx->inputs[0], distance(s->in_end, pts), s->threshold))
+        return 0;
+    return pts > s->out_pos ? distance(s->out_pos, pts) : 0;
+}
+
+/* A step at or below the threshold, forward or backward, passes through:
+ * the output takes the same step, as it does without the filter. The frame
+ * keeps its own timestamp, or stays as far from it as an earlier joined
+ * overlap left the output. A longer overlap or backward step trims nothing,
+ * and the frame follows the previous one. */
+static void pass_short_step(AVFilterContext *ctx, int64_t pts)
+{
+    AGapFillContext *s = ctx->priv;
+    const uint64_t length = distance(s->in_end, pts);
+
+    if (!length)
+        return;
+    if (is_longer(ctx->inputs[0], length, s->threshold)) {
+        if (pts < s->in_end)
+            s->nb_joined++;
+        return;
+    }
+    s->out_pos = moved(s->out_pos, length, pts > s->in_end);
+    s->nb_passed++;
+}
+
+/* Owe silence before the input that begins at pts, unless the silence is
+ * longer than max_gap. */
+static int owe_silence(AVFilterContext *ctx, int64_t pts, uint64_t silence)
+{
+    AVFilterLink *inlink = ctx->inputs[0];
+    AGapFillContext *s = ctx->priv;
+
+    if (silence && s->max_gap > 0 && is_longer(inlink, silence, s->max_gap)) {
+        av_log(ctx, AV_LOG_ERROR,
+               "The frame at sample %"PRId64" needs %"PRIu64" samples of silence "
+               "before it, which is longer than max_gap.\n", pts, silence);
+        return AVERROR(EINVAL);
+    }
+    /* The output stops at the largest timestamp long before longer silence
+     * ends. */
+    s->silence_left = FFMIN(silence, INT64_MAX);
+    if (silence) {
+        s->nb_gaps++;
+        s->nb_silence = av_sat_add64(s->nb_silence, s->silence_left);
+        av_log(ctx, AV_LOG_VERBOSE,
+               "Writing %"PRIu64" samples of silence from sample %"PRId64".\n",
+               silence, s->out_pos);
+    }
+
+    return 0;
+}
+
+/**
+ * Find where the frame begins on the output timeline and how much silence
+ * the filter writes before the frame. The filter then holds the frame.
+ */
+static int place_frame(AVFilterContext *ctx, AVFrame *frame)
+{
+    AVFilterLink *inlink = ctx->inputs[0];
+    AGapFillContext *s = ctx->priv;
+    const AVRational sample = { 1, inlink->sample_rate };
+    int64_t pts = AV_NOPTS_VALUE;
+    uint64_t silence = 0;
+    int ret;
+
+    if (frame->pts != AV_NOPTS_VALUE)
+        pts = rescale_saturated(frame->pts, inlink->time_base, sample, AV_ROUND_NEAR_INF);
+
+    if (!s->started) {
+        int64_t start = INT64_MAX;
+
+        if (s->start != INT64_MAX)
+            start = rescale_saturated(s->start, AV_TIME_BASE_Q, sample, AV_ROUND_UP);
+        if (pts == AV_NOPTS_VALUE)
+            pts = start != INT64_MAX ? start : 0;
+        /* No threshold applies here: the timeline begins exactly at start. */
+        if (pts > start)
+            silence = distance(start, pts);
+        s->out_pos = FFMIN(pts, start);
+        s->started = 1;
+    } else {
+        if (pts == AV_NOPTS_VALUE)
+            pts = s->in_end;
+        silence = silence_after_step(ctx, pts);
+        pass_short_step(ctx, pts);
+    }
+
+    ret = owe_silence(ctx, pts, silence);
+    if (ret < 0)
+        return ret;
+
+    s->max_offset = FFMAX(s->max_offset,
+                          FFABS(av_sat_sub64(moved(s->out_pos, silence, 1), pts)));
+    s->in_end     = av_sat_add64(pts, frame->nb_samples);
+    s->held       = frame;
+
+    return 0;
+}
+
+static int send_silence(AVFilterContext *ctx)
+{
+    AVFilterLink *outlink = ctx->outputs[0];
+    AGapFillContext *s = ctx->priv;
+    const int nb_samples = FFMIN(s->silence_left, s->packet_size);
+    AVFrame *frame = ff_get_audio_buffer(outlink, nb_samples);
+
+    if (!frame)
+        return AVERROR(ENOMEM);
+
+    av_samples_set_silence(frame->extended_data, 0, nb_samples,
+                           frame->ch_layout.nb_channels, frame->format);
+    frame->pts      = s->out_pos;
+    frame->duration = nb_samples;
+
+    s->out_pos       = av_sat_add64(s->out_pos, nb_samples);
+    s->silence_left -= nb_samples;
+
+    return ff_filter_frame(outlink, frame);
+}
+
+static int send_held(AVFilterContext *ctx)
+{
+    AGapFillContext *s = ctx->priv;
+    AVFrame *frame = s->held;
+
+    s->held         = NULL;
+    frame->pts      = s->out_pos;
+    frame->duration = frame->nb_samples;
+
+    s->out_pos = av_sat_add64(s->out_pos, frame->nb_samples);
+
+    return ff_filter_frame(ctx->outputs[0], frame);
+}
+
+static int activate(AVFilterContext *ctx)
+{
+    AVFilterLink *inlink = ctx->inputs[0];
+    AVFilterLink *outlink = ctx->outputs[0];
+    AGapFillContext *s = ctx->priv;
+    int64_t pts;
+    int ret, status;
+
+    FF_FILTER_FORWARD_STATUS_BACK(outlink, inlink);
+
+    if (!s->held) {
+        AVFrame *frame;
+
+        ret = ff_inlink_consume_frame(inlink, &frame);
+        if (ret < 0)
+            return ret;
+        if (ret > 0) {
+            ret = place_frame(ctx, frame);
+            if (ret < 0) {
+                av_frame_free(&frame);
+                return ret;
+            }
+        }
+    }
+
+    if (s->held) {
+        if (s->silence_left) {
+            /* One frame of silence for each frame the next filter asks for,
+             * so that no part of a long gap waits in a queue. */
+            if (!ff_outlink_frame_wanted(outlink))
+                return FFERROR_NOT_READY;
+            ret = send_silence(ctx);
+            if (ret < 0 || s->silence_left)
+                return ret;
+        }
+        return send_held(ctx);
+    }
+
+    if (ff_inlink_acknowledge_status(inlink, &status, &pts)) {
+        if (s->started)
+            pts = s->out_pos;
+        else if (pts != AV_NOPTS_VALUE)
+            pts = av_rescale_q(pts, inlink->time_base, outlink->time_base);
+        ff_outlink_set_status(outlink, status, pts);
+        return 0;
+    }
+
+    FF_FILTER_FORWARD_WANTED(outlink, inlink);
+
+    return FFERROR_NOT_READY;
+}
+
+static int config_output(AVFilterLink *outlink)
+{
+    AVFilterContext *ctx = outlink->src;
+    AVFilterLink *inlink = ctx->inputs[0];
+    AGapFillContext *s = ctx->priv;
+    const AVRational sample = { 1, inlink->sample_rate };
+
+    /* A timestamp in another time base is up to one of its ticks away from
+     * the sample it stamps, and rounding it to a sample moves it by up to one
+     * sample more. A threshold below that sum would read rounding as gaps. */
+    if (av_cmp_q(inlink->time_base, sample) &&
+        av_compare_ts(s->threshold, AV_TIME_BASE_Q,
+                      1, av_add_q(inlink->time_base, sample)) < 0) {
+        av_log(ctx, AV_LOG_ERROR,
+               "The threshold is below one tick of the input time base %d/%d "
+               "plus one sample, so rounded timestamps would count as gaps.\n",
+               inlink->time_base.num, inlink->time_base.den);
+        return AVERROR(EINVAL);
+    }
+
+    outlink->time_base = sample;
+
+    return 0;
+}
+
+static av_cold void uninit(AVFilterContext *ctx)
+{
+    AGapFillContext *s = ctx->priv;
+
+    av_frame_free(&s->held);
+    if (s->started)
+        av_log(ctx, AV_LOG_VERBOSE,
+               "gaps:%"PRId64" silence_samples:%"PRId64" joined_steps:%"PRId64" "
+               "passed_steps:%"PRId64" max_offset_samples:%"PRId64"\n",
+               s->nb_gaps, s->nb_silence, s->nb_joined, s->nb_passed, s->max_offset);
+}
+
+static const AVFilterPad agapfill_outputs[] = {
+    {
+        .name         = "default",
+        .type         = AVMEDIA_TYPE_AUDIO,
+        .config_props = config_output,
+    },
+};
+
+const FFFilter ff_af_agapfill = {
+    .p.name        = "agapfill",
+    .p.description = NULL_IF_CONFIG_SMALL("Fill gaps between audio frames with silence."),
+    .p.priv_class  = &agapfill_class,
+    .priv_size     = sizeof(AGapFillContext),
+    .activate      = activate,
+    .uninit        = uninit,
+    FILTER_INPUTS(ff_audio_default_filterpad),
+    FILTER_OUTPUTS(agapfill_outputs),
+};

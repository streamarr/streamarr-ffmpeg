Index: FFmpeg/libavfilter/vf_tonemap_cuda.c
===================================================================
--- FFmpeg.orig/libavfilter/vf_tonemap_cuda.c
+++ FFmpeg/libavfilter/vf_tonemap_cuda.c
@@ -651,7 +651,9 @@ static av_cold int compile(AVFilterLink *inlink)
             for (j = 0; j < 3; j++)
                 ycc2rgb_offset[i] -= s->dovi->nonlinear[i][j] * s->dovi->nonlinear_offset[j];
         }
-        ff_matrix_mul_3x3(lms2rgb_matrix, dovi_lms2rgb_matrix, s->dovi->linear);
+        // ff_matrix_mul_3x3(dst, a, b) gives b x a, so a acts first: the RPU's linear matrix on LMS,
+        // then LMS to RGB.
+        ff_matrix_mul_3x3(lms2rgb_matrix, s->dovi->linear, dovi_lms2rgb_matrix);
     } else {
         ff_fill_rgb2yuv_table(in_coeffs, yuv_matrix);
         ff_matrix_invert_3x3(yuv_matrix, rgb_matrix);
Index: FFmpeg/libavfilter/vf_tonemap_d3d11.c
===================================================================
--- FFmpeg.orig/libavfilter/vf_tonemap_d3d11.c
+++ FFmpeg/libavfilter/vf_tonemap_d3d11.c
@@ -488,7 +488,9 @@ static void fill_dovi_params(TonemapD3D11Params *params,
         params->dovi_ycc2rgb_offset[i] = ycc2rgb_offset[i];
     }
 
-    ff_matrix_mul_3x3(lms2rgb, dovi_lms2rgb_matrix, dovi->linear);
+    // ff_matrix_mul_3x3(dst, a, b) gives b x a, so a acts first: the RPU's linear matrix on LMS,
+    // then LMS to RGB.
+    ff_matrix_mul_3x3(lms2rgb, dovi->linear, dovi_lms2rgb_matrix);
     copy_matrix(dovi->nonlinear, params->dovi_rgb_matrix);
     copy_matrix(lms2rgb, params->dovi_lms2rgb_matrix);
 

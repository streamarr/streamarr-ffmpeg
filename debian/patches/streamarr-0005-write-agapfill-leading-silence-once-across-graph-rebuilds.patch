@@ -2158,6 +2159,11 @@ static int configure_filtergraph(FilterG
     if ((ret = avfilter_graph_config(fgt->graph, NULL)) < 0)
         goto fail;
 
+    /* The graph that this one replaces has already written the silence that
+     * leads the audio. An agapfill filter must not write that silence again. */
+    if (rebuilt)
+        avfilter_graph_send_command(fgt->graph, "agapfill", "resume", NULL, NULL, 0, 0);

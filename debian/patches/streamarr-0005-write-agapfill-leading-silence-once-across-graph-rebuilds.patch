Index: FFmpeg/libavfilter/af_agapfill.c
===================================================================
--- FFmpeg.orig/libavfilter/af_agapfill.c
+++ FFmpeg/libavfilter/af_agapfill.c
@@ -21,6 +21,8 @@
  * Fill gaps between audio frames with silence, without dropping a sample.
  */
 
+#include <string.h>
+
 #include "libavutil/common.h"
 #include "libavutil/mathematics.h"
 #include "libavutil/opt.h"
@@ -39,6 +41,7 @@ typedef struct AGapFillContext {
     int packet_size;        ///< samples in each frame of silence
 
     int started;            ///< the first frame has arrived
+    int resumed;            ///< the graph replaces an earlier one, which wrote the leading silence
     int64_t out_pos;        ///< timestamp of the next output sample, in samples
     int64_t in_end;         ///< end of the previous input frame by its own timestamp, in samples
     int64_t silence_left;   ///< samples of silence still to write before the held frame
@@ -86,7 +89,7 @@ static int place_frame(AVFilterContext *
     if (!s->started) {
         int64_t start = INT64_MAX;
 
-        if (s->start != INT64_MAX)
+        if (s->start != INT64_MAX && !s->resumed)
             start = av_rescale_q_rnd(s->start, AV_TIME_BASE_Q, sample, AV_ROUND_UP);
         if (pts == AV_NOPTS_VALUE)
             pts = start != INT64_MAX ? start : 0;
@@ -244,6 +247,18 @@ static int config_output(AVFilterLink *o
     return 0;
 }
 
+static int process_command(AVFilterContext *ctx, const char *cmd, const char *args,
+                           char *res, int res_len, int flags)
+{
+    AGapFillContext *s = ctx->priv;
+
+    if (strcmp(cmd, "resume"))
+        return AVERROR(ENOSYS);
+    s->resumed = 1;
+
+    return 0;
+}
+
 static av_cold void uninit(AVFilterContext *ctx)
 {
     AGapFillContext *s = ctx->priv;

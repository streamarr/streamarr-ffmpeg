@@ -211,15 +211,27 @@ static __inline__ __device__ float read_dither(cudaTextureObject_t ditherTex, fl
     return tex2D<float>(ditherTex, (float)x * dither_size_recip, (float)y * dither_size_recip);
 }
 
+// A 16-bit texture holds an n-bit code as code * 2^(16-n) and reads as that over 65535.
+// This scales a read back to code / (2^n - 1), which the range scaling and the Dolby Vision
+// reshaping take. As elsewhere in this filter, 16-bit input is taken as 12-bit.
+static __inline__ __device__ float tex_to_code_scale()
+{
+    int depth = depth_src == 16 ? 12 : depth_src;
+    if (depth <= 8)
+        return 1.0f;
+    return 65535.0f / (float)(((1 << depth) - 1) << (16 - depth));
+}
+
 static __inline__ __device__ float3 read_tex_px_flt(const FFCUDAFrame& frame, int x, int y)
 {
     float ncoord_x = (float)x / (float)frame.width;
     float ncoord_y = (float)y / (float)frame.height;
+    float scale = tex_to_code_scale();
 
     float px_y = tex2D<float>(frame.tex[0], x, y);
     float2 px_uv = tex2D<float2>(frame.tex[1], ncoord_x, ncoord_y);
 
-    return make_float3(px_y, px_uv.x, px_uv.y);
+    return make_float3(px_y * scale, px_uv.x * scale, px_uv.y * scale);
 }
 
 #endif /* AVFILTER_CUDA_PIXFMT_H */

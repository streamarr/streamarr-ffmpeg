+// BT.2100 table 9, narrow range: D = Round[(scale * E' + offset) * 2^(n-8)] at the output depth n.
+// Returns the value before rounding as a fraction of 2^n - 1. sample_to_ushort() rounds it once,
+// after the dither and the chroma average.
+static __inline__ __device__ float scale_narrow(float e, float scale, float offset) {
+    float levels = (float)(1 << (depth_dst - 8));
+    return (scale * e + offset) * levels / (float)((1 << depth_dst) - 1);
+}
+

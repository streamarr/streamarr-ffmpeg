--- FFmpeg.orig/libavfilter/cuda/pixfmt.h
+++ FFmpeg/libavfilter/cuda/pixfmt.h
@@ -181,7 +181,7 @@ static __inline__ __device__ void write_2x2(const FFCUDAFrame& frame, int x, int
 

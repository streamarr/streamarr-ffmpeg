+        float zero = full_range_chroma_zero(depth_src == 16 ? 12 : depth_src);
+        u -= zero;
+        v -= zero;
     }
     float r = y * rgb_matrix[0] + u * rgb_matrix[1] + v * rgb_matrix[2];

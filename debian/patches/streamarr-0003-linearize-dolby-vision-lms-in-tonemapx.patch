+static int compute_dovi_pq_luts(TonemapxContext *s)
+{
+    const double m1 = 2610.0 / 16384, m2 = 2523.0 / 4096 * 128;
+    const double c1 = 3424.0 / 4096, c2 = 2413.0 / 4096 * 32, c3 = 2392.0 / 4096 * 32;
+
+    float *eotf, *oetf;
+
+    if (s->pq_eotf_lut)
+        return 0;
+
+    eotf = av_malloc_array(PQ_EOTF_LUT_SIZE, sizeof(*eotf));
+    oetf = av_malloc_array(PQ_OETF_LUT_SIZE, sizeof(*oetf));
+    if (!eotf || !oetf) {
+        av_free(eotf);
+        av_free(oetf);
+        return AVERROR(ENOMEM);
+    }
+
+    for (unsigned i = 0; i < PQ_EOTF_LUT_SIZE; i++) {
+        double p = pow(FFMIN(i, PQ_EOTF_LUT_STEPS) / (double)PQ_EOTF_LUT_UNIT, 1.0 / m2);
+        eotf[i] = pow(FFMAX(p - c1, 0.0) / (c2 - c3 * p), 1.0 / m1);
+    }
+    for (unsigned i = 0; i < PQ_OETF_LUT_SIZE; i++) {
+        double p = pow(av_int2float(PQ_OETF_LUT_MIN_BITS + (FFMIN(i, PQ_OETF_LUT_STEPS) << PQ_OETF_LUT_SHIFT)), m1);
+        oetf[i] = pow((c1 + c2 * p) / (1.0 + c3 * p), m2);
+    }
+
+    s->pq_eotf_lut = eotf;
+    s->pq_oetf_lut = oetf;
+
+    return 0;
+}

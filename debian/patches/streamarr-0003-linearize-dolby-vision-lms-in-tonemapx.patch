Index: FFmpeg/libavfilter/vf_tonemapx.h
===================================================================
--- FFmpeg.orig/libavfilter/vf_tonemapx.h
+++ FFmpeg/libavfilter/vf_tonemapx.h
@@ -21,6 +21,8 @@
 
 #include "config.h"
 #include "colorspace.h"
+#include "libavutil/common.h"
+#include "libavutil/intfloat.h"
 
 #define X86_64_V2 __attribute__((target("sse4.2")))
 #define X86_64_V3 __attribute__((target("avx2,fma")))
@@ -83,8 +85,76 @@ typedef struct TonemapIntParams {
     float *dovi_pbuf;
     double (*lms2rgb_matrix)[3][3];
     float (*ycc_offset)[3];
+    const float *pq_eotf_lut;
+    const float *pq_oetf_lut;
 } TonemapIntParams;
 
+/*
+ * Tables for the PQ EOTF and its inverse, both with 1.0 as 10000 nits.
+ * The EOTF table has one entry per 1 / PQ_EOTF_LUT_UNIT of the signal up to PQ_EOTF_LUT_MAX, and
+ * one more so that the entry above the last can be read. It runs past 1.0 because L'M'S' does:
+ * with the profile 5 matrix a saturated bright pixel reaches 1.36, and the EOTF formula still
+ * holds there. The inverse table has 64 entries per octave of
+ * the linear value from 2^-PQ_OETF_LUT_OCTAVES up to 1.0, at the values whose float bit patterns
+ * are 2^17 apart, and one more for the same reason. Both are read with linear interpolation.
+ */
+#define PQ_EOTF_LUT_UNIT 16384
+#define PQ_EOTF_LUT_MAX 1.375f
+#define PQ_EOTF_LUT_STEPS 22528 // PQ_EOTF_LUT_UNIT * PQ_EOTF_LUT_MAX
+#define PQ_EOTF_LUT_SIZE (PQ_EOTF_LUT_STEPS + 2)
+#define PQ_OETF_LUT_OCTAVES 40
+#define PQ_OETF_LUT_SHIFT 17
+#define PQ_OETF_LUT_STEPS (PQ_OETF_LUT_OCTAVES << (23 - PQ_OETF_LUT_SHIFT))
+#define PQ_OETF_LUT_SIZE (PQ_OETF_LUT_STEPS + 2)
+#define PQ_OETF_LUT_MIN_BITS ((uint32_t)(127 - PQ_OETF_LUT_OCTAVES) << 23)
+
+static av_always_inline float tonemapx_pq_eotf(const float *lut, float v)
+{
+    float pos = av_clipf(v, 0.0f, PQ_EOTF_LUT_MAX) * PQ_EOTF_LUT_UNIT;
+    int i = (int)pos;
+
+    return lut[i] + (pos - (float)i) * (lut[i + 1] - lut[i]);
+}
+
+static av_always_inline float tonemapx_pq_oetf(const float *lut, float x)
+{
+    uint32_t bits, i;
+
+    if (!(x < 1.0f))
+        return x == x ? lut[PQ_OETF_LUT_STEPS] : 0.0f;
+
+    bits = av_float2int(x);
+    // Negative values have the sign bit set and compare above every positive value.
+    if (bits < PQ_OETF_LUT_MIN_BITS || bits >> 31)
+        return FFMAX(x, 0.0f) * lut[0] / av_int2float(PQ_OETF_LUT_MIN_BITS);
+
+    bits -= PQ_OETF_LUT_MIN_BITS;
+    i = bits >> PQ_OETF_LUT_SHIFT;
+
